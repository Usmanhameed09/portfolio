# Hardcoded password for /proposal-generator route
PASSWORD=change-me

# Choose one provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Vercel Blob — required on Vercel for persistent KB / prompts / links.
# Auto-set when you attach a Blob store to the project.
# Leave blank locally to use filesystem storage instead.
BLOB_READ_WRITE_TOKEN=
