# Password for the /proposal-generator route
PASSWORD=change-me

# LLM provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI (needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4

# Gemini (needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Supabase storage (optional — both URL + KEY required to enable;
# leave blank to use local knowledge-base/ filesystem storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=proposal-gen
